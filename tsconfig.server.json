{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": [
    "src/server/**/*.ts",
    "src/shared/api.ts",
    "src/shared/bytes.ts",
    "src/shared/limits.ts",
    "src/shared/share-api.ts"
  ]
}
