{
  "name": "env-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch src/server/main.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps --only-shell",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vitest run"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@hono/node-server": "1.14.3",
    "better-sqlite3": "^11.9.1",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "concurrently": "^9.1.2",
    "lefthook": "^1.11.12",
    "svelte": "^5.57.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
