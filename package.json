{
  "name": "env-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vp dev\" \"tsx watch src/server/main.ts\"",
    "build": "vp build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps --only-shell",
    "check": "vp check"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@hono/node-server": "1.14.3",
    "better-sqlite3": "^11.9.1",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "concurrently": "^9.1.2",
    "lefthook": "^1.11.12",
    "svelte": "^5.57.0",
    "tsx": "^4.19.4",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
