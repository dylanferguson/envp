{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "envp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "PUBLIC_ORIGIN": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "envp",
      "database_id": "local-envp-db",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/share/*"],
  },
}
