{
  "containers": [
    {
      "name": "nginx",
      "image": "nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236",
      "files": [
        {
          "guest_path": "/etc/nginx/conf.d/default.conf",
          "local_path": "deploy/nginx/default.conf"
        }
      ],
      "depends_on": [
        {
          "name": "envp",
          "condition": "healthy"
        }
      ]
    },
    {
      "name": "envp",
      "image": "envp:go-scratch",
      "healthchecks": [
        {
          "http": {
            "port": 9090,
            "method": "GET",
            "path": "/health",
            "scheme": "http"
          },
          "grace_period": 10,
          "interval": 30,
          "timeout": 3
        }
      ]
    }
  ]
}
