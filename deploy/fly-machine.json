{
  "containers": [
    {
      "name": "envp",
      "image": "envp:go-scratch",
      "healthchecks": [
        {
          "http": {
            "port": 9090,
            "method": "GET",
            "path": "/health",
            "scheme": "http"
          },
          "grace_period": 10,
          "interval": 30,
          "timeout": 3
        }
      ]
    },
    {
      "name": "nginx",
      "image": "registry.fly.io/envp:nginx"
    }
  ]
}
