{
  "containers": [
    {
      "name": "envp",
      "image": "envp:go-scratch",
      "env": {
        "PORT": "8081",
        "LISTEN_HOST": "127.0.0.1"
      },
      "healthchecks": [
        {
          "http": {
            "port": 9090,
            "method": "GET",
            "path": "/health",
            "scheme": "http"
          },
          "grace_period": 10,
          "interval": 30,
          "timeout": 3
        }
      ]
    },
    {
      "name": "nginx",
      "image": "registry.fly.io/envp:nginx",
      "secrets": [
        {
          "env_var": "X_ORIGIN_TOKEN",
          "name": "X_ORIGIN_TOKEN"
        }
      ]
    }
  ]
}
